/* The chat's history stays inside the model's window: past 75% of it the oldest whole turns drop,
   a quarter of the history at a time, so the prompt's start stays the same between drops and the
   model server's cache is reused. A tool's result shows at most 4,000 tokens. */
history { max-tokens: 75win; overflow: drop-start; drop-step: 25%; }
result  { max-tokens: 4000tok; overflow: clip-middle; more: "\n[... cut ...]\n"; }
